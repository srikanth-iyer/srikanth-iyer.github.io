---
// research.astro: the full research section: projects, talks and posters, news, education.
import Site from '../layouts/Site.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ResearchList from '../components/sections/ResearchList.astro';
import profile from '../data/profile.json';
import talks from '../data/talks.json';
import news from '../data/news.json';
---
<Site title="Research" current="research" description="Research by Srikanth Iyer on collective intelligence: cellular automata under noise, canalization, Boolean networks and language-model agents.">
  <section class="band" data-theme="research">
    <div class="wrap section">
      <SectionHeader number={1} label="Research" level="h1"><b>How groups decide</b>, from cells to language models</SectionHeader>
      <p class="lead intro">{profile.shortBio} I work at Binghamton University's CASCI lab and in the CBeRa group at the Católica Biomedical Research Centre.</p>
      <ResearchList detailed />

      <h2 class="sub" id="talks">Talks and posters</h2>
      <ol class="talks">
        {talks.map((t) => (
          <li>
            <span class="venue">{t.short}<span class="kind">{t.type}</span></span>
            <div class="tbody">
              <b>{t.title}</b>
              <span class="text small" set:html={t.authors.replace('S. Iyer', '<u>S. Iyer</u>') + '. ' + t.venue + '.'} />
              {t.award && <span class="award">{t.award}</span>}
              {t.note && <span class="meta">{t.note}</span>}
            </div>
          </li>
        ))}
      </ol>
      <p class="meta">Manuscripts on canalization and robustness under noise are in preparation.</p>

      <div class="two">
        <div>
          <h2 class="sub" id="news">News</h2>
          <ul class="rows">
            {news.map((n) => <li><span class="date">{n.date}</span><span class="text small" set:html={n.text} /></li>)}
          </ul>
        </div>
        <div>
          <h2 class="sub" id="education">Education</h2>
          <ul class="rows">
            {profile.education.map((e) => <li><span class="date">{e.years.replace(' – expected ', '–')}</span><span class="text small"><b>{e.degree}</b>, {e.school}</span></li>)}
          </ul>
          <h2 class="sub">Now</h2>
          <ul class="now">{profile.now.map((x) => <li class="text small">{x}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>
</Site>

<style>
  .intro { margin-bottom: var(--space-8); }
  .sub { margin: var(--space-12) 0 var(--space-4); font-family: var(--font-display); font-weight: 700; font-size: 26px; }
  .small { font-size: 16px; }
  .talks { list-style: none; margin: 0 0 var(--space-4); padding: 0; }
  .talks li { display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-6); padding-block: var(--space-4); border-top: var(--hairline) solid var(--line); }
  .venue { flex: 0 0 120px; display: flex; flex-direction: column; gap: 2px; font-family: var(--font-mono); font-size: 14px; font-weight: 600; color: var(--thread); }
  .kind { font-weight: 400; color: var(--muted); font-size: 12px; }
  .tbody { flex: 1 1 360px; min-width: 0; display: flex; flex-direction: column; gap: var(--space-1); }
  .tbody b { font-family: var(--font-display); font-size: 19px; line-height: 1.3; }
  .award { align-self: flex-start; background: var(--accent-soft); color: var(--ink); border-radius: var(--radius-chip); padding: 2px 8px; font-size: 14px; }
  .two { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr)); gap: 0 var(--space-12); }
  .rows { list-style: none; margin: 0; padding: 0; }
  .rows li { display: flex; gap: var(--space-4); padding-block: var(--space-3); border-top: 1px solid var(--line); }
  .date { flex: 0 0 84px; font-family: var(--font-mono); font-size: 13px; color: var(--muted); padding-top: 3px; }
  .now { margin: 0; padding-left: 20px; }
</style>
