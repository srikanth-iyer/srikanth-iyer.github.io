---
// Direction C · Academic folio: the classic academic layout, with a light/dark switch.
import Base from '../../layouts/Base.astro';
import profile from '../../data/profile.json';
import research from '../../data/research.json';
import talks from '../../data/talks.json';
import news from '../../data/news.json';
import film from '../../data/film.json';
---
<Base title={`${profile.name} · Academic folio`} fonts="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&family=Source+Serif+4:ital,wght@0,400;1,400&display=swap">
  <div class="page" id="folio" data-theme="light">
    <header>
      <div class="bar">
        <a class="logo" href="#top"><b>Srikanth</b> Iyer</a>
        <nav aria-label="Main">
          <a href="#top" class="current">about</a><a href="#talks">talks</a><a href="#projects">projects</a><a href="#film">film</a>
          <button type="button" id="theme" aria-label="Switch between light and dark theme">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
          </button>
        </nav>
      </div>
    </header>

    <main id="top">
      <section>
        <h1><b>Srikanth</b> Iyer</h1>
        <p class="muted">{profile.roles.map((r) => `${r.title}, ${r.org}`).join(' · ')}</p>
      </section>

      <section class="about">
        <div class="bio">{profile.bio.map((p) => <p>{p}</p>)}</div>
        <figure>
          {profile.photo ? <img src={profile.photo} alt={`Portrait of ${profile.name}`} /> : <div class="photo">[portrait]</div>}
        </figure>
      </section>

      <section>
        <h2>news</h2>
        <div class="rows">
          {news.map((n) => <div class="row"><span class="date">{n.date}</span><span set:html={n.text} /></div>)}
        </div>
      </section>

      <section id="talks">
        <h2>selected talks &amp; posters</h2>
        {talks.map((t) => (
          <div class="pub">
            <span class="abbr">{t.short}</span>
            <div>
              <b>{t.title}</b>
              <span class="muted" set:html={t.authors.replace('S. Iyer', '<u>S. Iyer</u>') + `. ${t.venue} (${t.type.toLowerCase()}).`} />
              {t.award && <span class="award">{t.award}</span>}
              {t.note && <span class="muted">{t.note}</span>}
            </div>
          </div>
        ))}
        <p class="muted small">Manuscripts on canalization and robustness under noise are in preparation.</p>
      </section>

      <section id="projects">
        <h2>projects</h2>
        <div class="cards">
          {research.map((r) => (
            <a class="card" href={r.story ? `/directions/folio/${r.story}/` : (r.link ?? `#${r.id}`)}>
              <b>{r.key} {r.rest}</b>
              <span class="muted">{r.tags.join(' · ')}</span>
            </a>
          ))}
        </div>
      </section>

      <section id="film">
        <h2>film &amp; writing</h2>
        <div class="rows">
          {film.map((f) => (
            <div class="row"><span class="date">{f.years}</span><span><b>{f.link ? <a href={f.link}>{f.title}</a> : f.title}</b>, {f.kind.toLowerCase()}. {f.role}. {f.summary}</span></div>
          ))}
        </div>
      </section>
    </main>

    <footer>
      <a href={`mailto:${profile.email}`}>email</a> · <a href={profile.links.github}>GitHub</a> · <a href={profile.links.linkedin}>LinkedIn</a>
    </footer>
  </div>
</Base>

<script>
  // The moon button swaps the page between light and dark colours,
  // and remembers the choice in this browser for next time.
  const page = document.getElementById('folio');
  let saved = null;
  try { saved = localStorage.getItem('folio-theme'); } catch (e) {}   // some browsers block storage; that's fine
  if (saved) page.dataset.theme = saved;
  document.getElementById('theme').addEventListener('click', () => {
    page.dataset.theme = page.dataset.theme === 'dark' ? 'light' : 'dark';
    try { localStorage.setItem('folio-theme', page.dataset.theme); } catch (e) {}
  });
</script>

<style>
  .page { --bg:#ffffff; --text:#1d1f21; --muted:#5f6368; --line:#e3e3e3; --card:#f4f5f4; --accent:#1b7f70; background: var(--bg); color: var(--text); font-family: Inter, system-ui, sans-serif; min-height: 100vh; }
  .page[data-theme="dark"] { --bg:#141716; --text:#e6e8e6; --muted:#a3aaa6; --line:#2c3230; --card:#1e2321; --accent:#5cc2b0; }
  a { color: var(--accent); }
  header { border-bottom: 1px solid var(--line); }
  .bar, main, footer { max-width: 920px; margin: 0 auto; padding-left: 24px; padding-right: 24px; }
  .bar { padding-top: 12px; padding-bottom: 12px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 8px 24px; }
  .logo { color: var(--text); text-decoration: none; font-size: 18px; }
  nav { display: flex; flex-wrap: wrap; align-items: center; gap: 0 20px; }
  nav a { color: var(--text); text-decoration: none; padding: 10px 0; } nav a.current { color: var(--accent); }
  #theme { min-width: 44px; min-height: 44px; border: 0; border-radius: 10px; background: var(--card); color: var(--text); cursor: pointer; display: flex; align-items: center; justify-content: center; }
  main { padding-top: 48px; padding-bottom: 32px; display: flex; flex-direction: column; gap: 48px; }
  h1 { margin: 0 0 6px; font-size: clamp(36px, 5vw, 48px); font-weight: 300; } h1 b { font-weight: 700; }
  h2 { margin: 0 0 12px; font-size: 22px; font-weight: 600; color: var(--accent); }
  .muted { color: var(--muted); } .small { font-size: 14px; margin: 8px 0 0; }
  .about { display: flex; flex-wrap: wrap-reverse; gap: 32px; }
  .bio { flex: 1 1 420px; min-width: 0; font-family: 'Source Serif 4', Georgia, serif; font-size: 19px; line-height: 1.65; }
  .bio p { margin: 0 0 16px; }
  figure { flex: 0 0 240px; margin: 0; }
  .photo, figure img { width: 240px; height: 300px; border-radius: 12px; background: var(--card); color: var(--muted); display: flex; align-items: center; justify-content: center; object-fit: cover; }
  .rows .row { display: flex; gap: 24px; padding: 12px 0; border-top: 1px solid var(--line); font-size: 16px; line-height: 1.5; }
  .rows .row:last-child { border-bottom: 1px solid var(--line); }
  .date { flex: 0 0 96px; font-weight: 600; }
  .pub { display: flex; flex-wrap: wrap; gap: 12px 24px; margin-bottom: 20px; }
  .pub > div { flex: 1 1 400px; min-width: 0; display: flex; flex-direction: column; gap: 4px; font-size: 15px; }
  .pub b { font-size: 17px; }
  .abbr { flex: 0 0 104px; height: fit-content; font-size: 13px; font-weight: 700; color: #fff; background: #1b7f70; border-radius: 6px; padding: 6px 0; text-align: center; }
  .award { font-style: italic; color: var(--accent); }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; }
  .card { background: var(--card); border-radius: 12px; padding: 18px; display: flex; flex-direction: column; gap: 8px; text-decoration: none; color: var(--text); }
  footer { padding-top: 24px; padding-bottom: 32px; border-top: 1px solid var(--line); text-align: center; color: var(--muted); font-size: 14px; }
</style>
