---
// Builds the canalization explainer once for each design direction:
// /directions/talks/canalization/, /directions/specimen/canalization/, and so on.
import CanalizationExplainer from '../../../components/CanalizationExplainer.astro';
import themes from '../../../data/themes.json';

// getStaticPaths tells Astro which versions of this page to create, one per theme.
export function getStaticPaths() {
  return themes.map((theme) => ({ params: { theme: theme.slug }, props: { theme } }));
}
const { theme } = Astro.props;
---
<CanalizationExplainer theme={theme} />
