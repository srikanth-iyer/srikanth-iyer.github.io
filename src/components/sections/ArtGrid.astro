---
// ArtGrid.astro: the TouchDesigner pieces as gallery frames (art dialect: dark, square frames).
import art from '../../data/art.json';
---
<div class="gallery">
  {art.map((a) => (
    <figure>
      {a.image
        ? <img src={a.image} alt={`Still from ${a.title}`} />
        : <div class="frame">[still from {a.title}]</div>}
      <figcaption>
        <span class="title">{a.title}</span>
        <span class="text">{a.summary}</span>
        <span class="meta">{a.medium.toUpperCase()}</span>
      </figcaption>
    </figure>
  ))}
</div>

<style>
  .gallery { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: var(--space-8); }
  figure { margin: 0; display: flex; flex-direction: column; gap: var(--space-3); min-width: 0; }
  .frame, img { aspect-ratio: 16 / 10; width: 100%; max-width: 100%; border: var(--hairline) solid var(--line); border-radius: var(--radius-cell);
                object-fit: cover; box-sizing: border-box; }
  .frame { display: flex; align-items: center; justify-content: center; color: var(--muted); font-family: var(--font-mono); font-size: 13px; }
  figcaption { display: flex; flex-direction: column; gap: var(--space-2); }
  .title { font-family: var(--font-display); font-weight: 300; font-size: 28px; line-height: 1.15; color: var(--ink); }
  .text { font-size: 16px; }
</style>
