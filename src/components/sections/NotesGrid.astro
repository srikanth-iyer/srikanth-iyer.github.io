---
// NotesGrid.astro: notes as cards with a growth-stage chip (notes dialect).
// Seedling = a rough idea, budding = taking shape, evergreen = as finished as it gets.
import notes from '../../data/notes.json';
const { limit } = Astro.props;
const items = limit ? notes.slice(0, limit) : notes;
---
<ul class="notes">
  {items.map((n) => (
    <li>
      <span class="chip">{n.stage.toUpperCase()}</span>
      <span class="title">{n.title}</span>
      <span class="meta">{n.topic}</span>
    </li>
  ))}
</ul>

<style>
  .notes { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: var(--space-4); }
  li { background: var(--surface); border-radius: var(--radius-card); padding: var(--space-6); display: flex; flex-direction: column; gap: var(--space-3); min-width: 0; }
  .chip { align-self: flex-start; font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.04em; background: var(--accent-soft); color: var(--ink);
          border-radius: var(--radius-chip); padding: 3px 8px; }
  .title { font-family: var(--font-garden); font-style: italic; font-size: 24px; line-height: 1.25; color: var(--ink); text-wrap: balance; }
</style>
