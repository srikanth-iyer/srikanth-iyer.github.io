---
// ExplainerCards.astro: links to the scroll-driven explainers (explainers dialect).
// The blue/red strip on top is the explainers' motif: the two-way comparison colours.
import explainers from '../../data/explainers.json';
---
<div class="cards">
  {explainers.map((e) => (
    <a class="card" href={`/explainers/${e.id}/`}>
      <span class="strip" aria-hidden="true"><i></i><i></i></span>
      <span class="inner">
        <span class="meta">{e.kicker.toUpperCase()}</span>
        <span class="title">{e.title}</span>
        <span class="text">{e.summary}</span>
        <span class="more">Open the explainer →</span>
      </span>
    </a>
  ))}
</div>

<style>
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); gap: var(--space-4); }
  .card { display: flex; flex-direction: column; background: var(--surface); border-radius: var(--radius-card); overflow: hidden; text-decoration: none; color: var(--ink); min-width: 0; }
  .card:hover .title { text-decoration: underline; text-decoration-thickness: var(--hairline); text-underline-offset: 5px; }
  .strip { display: flex; height: 6px; }
  .strip i { flex: 1; background: var(--pair-a); }
  .strip i + i { background: var(--pair-b); }
  .inner { display: flex; flex-direction: column; gap: var(--space-2); padding: var(--space-6); }
  .title { font-family: var(--font-display); font-weight: 700; font-size: 26px; line-height: 1.2; text-wrap: balance; }
  .text { font-size: 16px; }
  .more { color: var(--thread); margin-top: var(--space-2); }
</style>
