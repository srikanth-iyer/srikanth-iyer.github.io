---
// FilmScenes.astro: film and writing credits written like screenplay scenes (film dialect):
// a slug line ("INT. FEATURE FILM – CAPGRAS – 2018–2022"), scene numbers in both margins, plain prose below.
import film from '../../data/film.json';
const { limit } = Astro.props;
const items = limit ? film.slice(0, limit) : film;
// Build the slug line from the data, e.g. "INT. FEATURE FILM – CAPGRAS – 2018–2022"
const slug = (f) => `INT. ${f.kind} – ${f.title} – ${f.years}`.toUpperCase();
---
<ol class="scenes">
  {items.map((f, i) => (
    <li>
      <span class="sn" aria-hidden="true">{i + 1}</span>
      <div class="scene">
        <h3>{slug(f)}</h3>
        <p class="meta">{f.role}</p>
        <p class="text">{f.summary}{f.link && <> <a href={f.link}>Watch →</a></>}</p>
      </div>
      <span class="sn right" aria-hidden="true">{i + 1}</span>
    </li>
  ))}
</ol>

<style>
  .scenes { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-8); max-width: 820px; }
  li { display: grid; grid-template-columns: 32px minmax(0, 1fr) 32px; gap: var(--space-3); }
  .sn { font-family: var(--font-screenplay); font-weight: 700; color: var(--accent); }
  .right { text-align: right; }
  .scene { display: flex; flex-direction: column; gap: var(--space-2); min-width: 0; }
  h3 { margin: 0; font-family: var(--font-screenplay); font-weight: 700; font-size: 18px; letter-spacing: 0.02em; line-height: 1.4;
       border-bottom: var(--hairline) solid var(--ink); padding-bottom: var(--space-2); overflow-wrap: anywhere; }
  .meta { margin: 0; }
  @media (max-width: 560px) { li { grid-template-columns: 20px minmax(0, 1fr); } .right { display: none; } }
</style>
