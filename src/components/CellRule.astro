---
// CellRule.astro: the divider between sections. A thin strip of cellular-automaton cells
// (7 time steps of the GKL rule on 149 cells), drawn in the colours of the section it opens.
// Every CellRule on the site starts from the same row, so it reads as one recurring signature.
---
<canvas class="cell-rule" aria-hidden="true"></canvas>

<style>
  .cell-rule { display: block; width: 100%; height: 28px; image-rendering: pixelated; background: var(--ground); }
</style>

<script>
  // Runs in the browser. Draws every divider on the page (Astro includes this script only once).
  const N = 149, ROWS = 7, PX = 4;
  // A small seeded random-number generator, so every divider starts from the same row.
  function rng(seed: number) {
    return () => {
      seed = (seed + 0x6d2b79f5) | 0;
      let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }
  // One GKL step: a white cell polls itself and the cells 1 and 3 to its left,
  // a black cell polls itself and the cells 1 and 3 to its right; the majority wins.
  function gkl(s: Uint8Array) {
    const out = new Uint8Array(N);
    for (let i = 0; i < N; i++) {
      const a = s[i];
      const b = a ? s[(i + 1) % N] : s[(i - 1 + N) % N];
      const c = a ? s[(i + 3) % N] : s[(i - 3 + N) % N];
      out[i] = a + b + c >= 2 ? 1 : 0;
    }
    return out;
  }
  document.querySelectorAll<HTMLCanvasElement>('canvas.cell-rule').forEach((canvas) => {
    const css = getComputedStyle(canvas);
    const on = css.getPropertyValue('--cell-on').trim();     // the section's "black cell" colour
    const off = css.getPropertyValue('--ground').trim();     // the section's background
    canvas.width = N * PX;
    canvas.height = ROWS * PX;
    const g = canvas.getContext('2d')!;
    const rand = rng(7);
    let row = new Uint8Array(N);
    for (let i = 0; i < N; i++) row[i] = rand() < 0.47 ? 1 : 0;
    g.fillStyle = off;
    g.fillRect(0, 0, canvas.width, canvas.height);
    g.fillStyle = on;
    for (let y = 0; y < ROWS; y++) {
      for (let x = 0; x < N; x++) if (row[x]) g.fillRect(x * PX, y * PX, PX, PX);
      row = gkl(row);
    }
  });
</script>
