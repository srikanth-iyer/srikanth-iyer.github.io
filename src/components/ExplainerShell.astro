---
// ExplainerShell.astro: the frame shared by the scroll-driven explainers.
// It sets the colours and fonts of one design direction ("theme"), places a fixed
// background canvas behind the text, and provides the header and the step counter.
import Base from '../layouts/Base.astro';
import profile from '../data/profile.json';

// "back" is where the top-left link goes (the site's explainer list, or a design direction's page).
const { theme, title, description, back } = Astro.props;
const backHref = back?.href ?? `/directions/${theme.slug}/`;
const backLabel = back?.label ?? profile.name;

// Turn the theme's colour/font settings into CSS variables, e.g. "--bg:#ffffff;--text:#141414;..."
const cssVars = Object.entries(theme.vars).map(([k, v]) => `--${k}:${v}`).join(';') + `;--band:${theme.band}`;
---
<Base title={`${title} · ${profile.name}`} description={description} fonts={theme.fonts} background={theme.vars.bg}>
  <div class={`xp xp-${theme.slug}`} style={cssVars}
       data-cell-on={theme.cells.on} data-cell-opacity={theme.cells.opacity}>
    <!-- The background simulation: fixed behind everything, redrawn as you scroll -->
    <canvas class="xp-bg" id="xp-bg" aria-hidden="true"></canvas>

    <header class="xp-top">
      <a href={backHref}>← {backLabel}</a>
      <span class="xp-kicker">EXPLAINER</span>
    </header>

    <main class="xp-main">
      <slot />
    </main>

    <!-- A small live readout of where the background simulation is -->
    <div class="xp-hud" id="xp-hud" aria-live="off"></div>
  </div>
</Base>

<style is:global>
  /* All rules start with .xp so they only affect explainer pages */
  .xp { background: var(--bg); color: var(--text); font-family: var(--sans); min-height: 100vh; position: relative; }
  .xp a { color: var(--accent); }
  .xp-bg { position: fixed; inset: 0; width: 100vw; height: 100vh; z-index: 0; pointer-events: none; }
  .xp-top { position: sticky; top: 0; z-index: 3; display: flex; justify-content: space-between; align-items: center; gap: 12px;
            padding: 12px 24px; background: var(--panel); border-bottom: 1px solid var(--line); font-size: 15px; }
  .xp-top a { text-decoration: none; font-weight: 600; padding: 10px 0; }
  .xp-kicker { font-family: var(--mono); font-size: 12px; letter-spacing: 0.12em; color: var(--muted); }
  .xp-main { position: relative; z-index: 1; max-width: 760px; margin: 0 auto; padding: 8vh 20px 30vh; }
  .xp-hud { position: fixed; right: 16px; bottom: 16px; z-index: 3; font-family: var(--mono); font-size: 13px; line-height: 1.4;
            background: var(--panel); color: var(--text); border: 1px solid var(--line); border-radius: var(--radius);
            padding: 8px 12px; max-width: 60vw; }

  /* A "step" is one stop in the story; each gets about a screen of scroll */
  .xp .step { min-height: 88vh; display: flex; flex-direction: column; justify-content: center; padding: 6vh 0; }
  .xp .card { background: var(--panel); border-radius: var(--radius); padding: clamp(20px, 4vw, 36px);
              border: var(--border) solid var(--line); box-shadow: 0 1px 0 var(--line); backdrop-filter: blur(2px); }
  .xp .badge { display: flex; align-items: center; gap: 10px; margin: 0 0 12px; font-family: var(--mono); font-size: 13px;
               letter-spacing: 0.08em; color: var(--accent); text-transform: uppercase; }
  .xp .badge b { width: 28px; height: 28px; border-radius: 999px; background: var(--accent-strong); color: var(--on-accent);
                 display: inline-flex; align-items: center; justify-content: center; font-family: var(--display); font-size: 15px; }
  .xp-lab .badge b { border-radius: 0; }
  .xp h1 { font-family: var(--display); font-weight: var(--title-weight); font-size: clamp(36px, 6vw, 64px); line-height: 1.08; margin: 0 0 18px; }
  .xp h2 { font-family: var(--display); font-weight: var(--title-weight); font-size: clamp(26px, 3.6vw, 38px); line-height: 1.18; margin: 0 0 16px; }
  .xp h1 b, .xp h2 b { font-weight: var(--key-weight); }
  .xp-talks h1 b, .xp-talks h2 b, .xp-collective h1 b, .xp-collective h2 b { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 6px; }
  .xp-lab h1 b, .xp-lab h2 b { background: var(--highlight); }
  .xp p, .xp li { font-family: var(--prose); font-size: 18px; line-height: 1.65; color: var(--body); }
  .xp p { margin: 0 0 14px; }
  .xp .eg { font-style: italic; color: var(--accent); font-size: 16px; }
  .xp .fine { font-size: 14px; color: var(--muted); }
  .xp .award { display: inline-block; font-family: var(--mono); font-size: 13px; background: var(--highlight); color: #111;
               padding: 6px 10px; border-radius: 6px; margin: 4px 0 16px; }
  .xp .grid3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; margin: 16px 0; }
  .xp .tile { background: var(--tint); border-radius: var(--radius); padding: 14px 16px; border: var(--border) solid var(--line); }
  .xp .tile b { display: block; font-family: var(--display); font-size: 18px; margin-bottom: 4px; color: var(--text); }
  .xp .tile span { font-size: 15px; line-height: 1.5; color: var(--body); }
  .xp .takeaway { background: var(--band); color: #fff; padding: 28px 32px; border-radius: var(--radius); }
  .xp .takeaway span { font-family: var(--mono); font-size: 12px; letter-spacing: 0.12em; opacity: 0.85; }
  .xp .takeaway p { color: #fff; font-family: var(--display); font-size: clamp(22px, 2.8vw, 30px); line-height: 1.3; margin: 8px 0 0; }
  .xp .refs { background: var(--text); color: var(--bg); padding: 20px 24px; border-radius: var(--radius); }
  .xp .refs p, .xp .refs li { color: var(--bg); font-size: 14px; line-height: 1.6; margin: 0; }
  .xp .refs a { color: var(--bg); }
  .xp figure { margin: 18px 0 8px; }
  .xp figcaption { font-size: 14px; color: var(--muted); margin-top: 8px; }
  .xp button.chip { min-height: 44px; padding: 0 14px; border-radius: 999px; border: 1.5px solid var(--line);
                    background: var(--tint); color: var(--text); font-family: var(--mono); font-size: 14px; cursor: pointer; }
  .xp button.chip[aria-pressed="true"] { background: var(--accent-strong); color: var(--on-accent); border-color: var(--accent-strong); }
  .xp-lab button.chip, .xp-notebook button.chip { border-radius: 0; }
  @media (max-width: 600px) { .xp p, .xp li { font-size: 17px; } .xp-hud { font-size: 12px; } }
</style>
