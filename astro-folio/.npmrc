# This project is primarily pnpm-based (see packageManager in package.json).
# When installing with npm instead, the dev-only oxlint / oxlint-tsgolint
# linter packages have a peer-version mismatch that npm treats as a hard
# error. They are not used to run or build the site, so we relax peer
# resolution to let `npm install` succeed.
legacy-peer-deps=true
